{
  "name": "native-demo-mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform (Android + iOS) UI tests for the WebdriverIO Native Demo App v2.2.0 with Appium 2 + WebdriverIO + TypeScript",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:android": "cross-env PLATFORM=android wdio run ./wdio.conf.ts",
    "test:ios": "cross-env PLATFORM=ios wdio run ./wdio.conf.ts",
    "test:android:smoke": "cross-env PLATFORM=android wdio run ./wdio.conf.ts --suite smoke",
    "test:ios:smoke": "cross-env PLATFORM=ios wdio run ./wdio.conf.ts --suite smoke",
    "report": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "typecheck": "tsc --noEmit",
    "download:app": "node scripts/download-app.mjs",
    "download:app:ios": "node scripts/download-app.mjs ios",
    "appium:drivers": "cross-env APPIUM_HOME=. appium driver list --installed",
    "doctor:android": "cross-env APPIUM_HOME=. appium driver doctor uiautomator2",
    "doctor:ios": "cross-env APPIUM_HOME=. appium driver doctor xcuitest"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@wdio/allure-reporter": "^9.33.1",
    "@wdio/appium-service": "^9.33.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "allure-commandline": "^2.46.1",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.9",
    "appium-xcuitest-driver": "^9.10.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "typescript": "^5.9.3",
    "webdriverio": "^9.33.1"
  },
  "engines": {
    "node": ">=18.20"
  }
}
