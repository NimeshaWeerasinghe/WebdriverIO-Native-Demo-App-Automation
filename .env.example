# Copy this file to .env and fill in the values for your device:  cp .env.example .env
# .env is ignored by git, so device ids and signing details stay on your machine.

# Which platform to run: android | ios  (npm run test:android / test:ios set this for you)
PLATFORM=android

# Optional: an Appium server that is already running. Leave empty to let the tests start their own.
# APPIUM_SERVER_URL=http://127.0.0.1:4723

# ---------- Android ----------
# Device id from "adb devices". Optional when exactly one device is connected.
ANDROID_UDID=
# Any readable name for the device; it appears in logs and reports.
ANDROID_DEVICE_NAME=Android Device
# Optional, e.g. 14. Appium detects it when left empty.
ANDROID_PLATFORM_VERSION=
# Path to the APK, relative to the project folder. "npm run download:app" puts it at the default path.
ANDROID_APP_PATH=apps/android/android.wdio.native.app.v2.2.0.apk

# ---------- iOS ----------
# true = iOS simulator (works with the release's simulator build), false = real iPhone.
IOS_SIMULATOR=false
# Simulator only: true runs it without a window (used on CI).
IOS_HEADLESS=false
# Real device: id from "xcrun xctrace list devices" (required).
# Simulator: id from "xcrun simctl list devices", or leave empty and set IOS_DEVICE_NAME + IOS_PLATFORM_VERSION.
IOS_UDID=
IOS_DEVICE_NAME=iPhone
IOS_PLATFORM_VERSION=
# Simulator: apps/ios/ios.simulator.wdio.native.app.v2.2.0.zip ("npm run download:app:ios" puts it there).
# Real device: a signed device build (.ipa or .app). The simulator build will NOT install on an iPhone.
IOS_APP_PATH=
# Or, if the app is already installed on the device, its bundle id:
IOS_BUNDLE_ID=
# Real device only - WebDriverAgent signing: your Apple Developer Team ID, and optionally a unique WDA bundle id.
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=Apple Development
IOS_WDA_BUNDLE_ID=
