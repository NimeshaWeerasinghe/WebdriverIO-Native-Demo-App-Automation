{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "@wdio/appium-service",
      "@wdio/allure-reporter"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "pageobjects/**/*.ts",
    "locators/**/*.ts",
    "config/**/*.ts",
    "utils/**/*.ts",
    "wdio.conf.ts"
  ]
}
